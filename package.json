{
  "name": "ressu",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "0BSD",
  "scripts": {
    "dev": "mygo dev",
    "build": "mygo build",
    "generate": "mygo generate",
    "dev:web": "vite --config webview/vite.config.ts",
    "build:web": "tsc -p webview/tsconfig.json --noEmit && vite build --config webview/vite.config.ts",
    "preview": "vite preview --config webview/vite.config.ts",
    "typecheck": "tsc -p webview/tsconfig.json --noEmit",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check": "bun run typecheck && bun run lint && bun run fmt:check",
    "test": "vitest run --config webview/vitest.config.ts",
    "test:watch": "vitest --config webview/vitest.config.ts"
  },
  "dependencies": {
    "@corvu/resizable": "^0.2.5",
    "@kobalte/core": "^0.13.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.17",
    "lucide-solid": "^1.69.0",
    "mygo-runtime": "^0.7.4",
    "solid-js": "^1.9.18",
    "solid-sonner": "^0.3.3",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@solidjs/testing-library": "^0.8.10",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "jsdom": "^31.0.0",
    "mygo-cli": "^0.7.4",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "tailwindcss": "^4.3.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-solid": "^2.11.15",
    "vitest": "^5.1.0"
  }
}
